# ==============================================================================
# File di esempio per le variabili d'ambiente (Environment Variables)
# ==============================================================================
# Copia questo file in '.env' sul tuo NAS ed inserisci i valori reali:
#   cp .env.example .env
# Il file '.env' è escluso da git (.gitignore) per non esporre dati sensibili.
# ==============================================================================

# --- MQTT BROKER (Home Assistant Mosquitto) ---
# Inserisci l'IP locale del tuo Home Assistant (es. 192.168.1.50) o il relativo hostname
MQTT_HOST=192.168.1.50
MQTT_USER=mqtt_user
MQTT_PASSWORD=tua_password_mqtt_sicura

# --- TELECAMERA TAPO (RTSP STREAM) ---
CAMERA_IP=192.168.1.100
CAMERA_USER=admin
CAMERA_PASSWORD=tua_password_telecamera

# --- COMPREFACE DATABASE (PostgreSQL) ---
POSTGRES_USER=compreface
POSTGRES_PASSWORD=compreface_db_password_sicura
POSTGRES_DB=compreface

# --- COMPREFACE / DOUBLE-TAKE ---
# La chiave generata dall'interfaccia web di CompreFace (http://<IP_NAS>:8000)
COMPREFACE_API_KEY=la_tua_api_key_creata_nella_dashboard
